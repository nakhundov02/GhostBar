{"body": "<html><head><title>GhostBar test page</title></head><body><h1>Browser integration fixture</h1><p>Page context: the blue bicycle is parked outside.</p><script nonce=\"uEr7N-lLdLm5uAY9mG2lZiBmSPw37I3n\">\n(() => {\n  if (window.top !== window || document.getElementById('ghostbar-mount')) return;\n  const origin = 'https://ghostbar.local';\n  const mount = document.createElement('div');\n  mount.id = 'ghostbar-mount';\n  const shadow = mount.attachShadow({ mode: 'closed' });\n  const style = document.createElement('style');\n  style.nonce = document.currentScript.nonce;\n  style.textContent = ':host{all:initial!important;position:fixed!important;top:0!important;right:0!important;z-index:2147483647!important}button{position:fixed;right:0;top:0;width:46px;height:46px;border:0;background:transparent;color:transparent;cursor:pointer;font:24px system-ui;border-radius:0 0 0 16px}button:hover,button:focus-visible{background:#171222;color:#c3b7ff;outline:2px solid #8970ff}iframe{position:fixed;right:14px;top:14px;width:min(440px,calc(100vw - 28px));height:min(670px,calc(100vh - 28px));border:1px solid #52416b;border-radius:18px;box-shadow:0 20px 70px #0007;background:#111019;display:none}iframe.open{display:block}';\n  const button = document.createElement('button');\n  button.textContent = '\u2726'; button.title = 'Open GhostBar'; button.setAttribute('aria-label', 'Open GhostBar');\n  const frame = document.createElement('iframe');\n  frame.title = 'GhostBar chat'; frame.referrerPolicy = 'origin';\n  frame.setAttribute('sandbox', 'allow-scripts allow-same-origin');\n  frame.setAttribute('allow', 'clipboard-write');\n  const open = () => {\n    if (!frame.src) frame.src = origin + '/';\n    frame.classList.add('open'); button.hidden = true;\n  };\n  button.addEventListener('click', open);\n  window.addEventListener('message', event => {\n    if (event.origin !== origin || event.source !== frame.contentWindow) return;\n    if (event.data?.type === 'ghostbar:close') { frame.classList.remove('open'); button.hidden = false; }\n    if (event.data?.type === 'ghostbar:capture' && typeof event.data.id === 'string') {\n      const selected = window.getSelection()?.toString().trim();\n      const text = selected || document.body.innerText;\n      frame.contentWindow.postMessage({\n        type: 'ghostbar:context', id: event.data.id,\n        title: document.title, url: location.origin + location.pathname,\n        text: text.slice(0, 60000), selected: !!selected\n      }, origin);\n    }\n  });\n  shadow.append(style, button, frame); document.documentElement.append(mount);\n})();\n</script>\n</body></html>", "headers": {"content-type": "text/html", "content-security-policy": "default-src 'self'; script-src 'nonce-uEr7N-lLdLm5uAY9mG2lZiBmSPw37I3n'; object-src 'none'; script-src-elem 'nonce-uEr7N-lLdLm5uAY9mG2lZiBmSPw37I3n' 'nonce-uEr7N-lLdLm5uAY9mG2lZiBmSPw37I3n'; style-src 'self' 'nonce-uEr7N-lLdLm5uAY9mG2lZiBmSPw37I3n'; style-src-elem 'self' 'nonce-uEr7N-lLdLm5uAY9mG2lZiBmSPw37I3n' 'nonce-uEr7N-lLdLm5uAY9mG2lZiBmSPw37I3n'; frame-src 'self' https://ghostbar.local", "strict-transport-security": "max-age=31536000", "x-frame-options": "DENY", "cache-control": "no-store"}}